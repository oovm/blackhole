                            <span class="hud-status">{{ hudMessage }}</span>
                            <div class="frame-actions">
                                <button
                                    type="button"
                                    class="icon-btn"
                                    :disabled="!hasDisplayedFrame"
                                    @click="(() => saveSnapshot())"
                                >
                                    保存
                                </button>
                                <button type="button" class="icon-btn" @click="(() => toggleFullscreen())">
                                    {{ isFullscreen ? "退出" : "全屏" }}
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="progress-dock" :class="{ active: isLoading }">
