                    >
                        <span class="pill-key">3</span>Ray March
                    </button>
                    <button
                        type="button"
                        :class="{ active: activePreset === 'fbm' }"
                        @click="(() => applyPreset('fbm'))"
                    >
                        <span class="pill-key">4</span>程序化盘
                    </button>
