                            @click="(() => setQualityTier('fast'))"
                        >
                            流畅
                        </button>
                        <button
                            type="button"
                            :class="{ active: qualityTier === 'standard' }"
                            @click="(() => setQualityTier('standard'))"
                        >
                            标准
                        </button>
                        <button
                            type="button"
                            :class="{ active: qualityTier === 'high' }"
                            @click="(() => setQualityTier('high'))"
                        >
