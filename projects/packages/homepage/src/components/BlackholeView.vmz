<script client>
import { renderTonFrame } from "../lib/blackhole-frame";

const SLIDER_DEBOUNCE_MS = 180;
const RESOLUTION_DEBOUNCE_MS = 60;

const QUALITY_TIERS = {
    fast: { label: "流畅", width: 480, height: 270 },
    standard: { label: "标准", width: 640, height: 360 },
    high: { label: "高清", width: 960, height: 540 },
};

const PRESETS = {
    schwarzschild: {
        name: "史瓦西薄盘",
        integrator: 0,
        diskModel: 1,
        mass: 1.0,
        spinRatio: 0.5,
    },
    kerr: {
        name: "克尔黑洞",
        integrator: 3,
        diskModel: 1,
        mass: 1.2,
        spinRatio: 0.65,
    },
    raymarch: {
        name: "Ray March",
        integrator: 1,
        diskModel: 0,
        mass: 1.5,
        spinRatio: 0.5,
    },
    fbm: {
        name: "程序化盘",
        integrator: 0,
        diskModel: 2,
        mass: 1.0,
        spinRatio: 0.5,
    },
};

const INTEGRATOR_NAMES = ["史瓦西轨道", "半经典 Ray March", "3D 零测地线", "克尔赤道"];
const DISK_NAMES = ["无盘", "Novikov-Thorne", "程序化 FBM"];

const LOADING_HINTS = [
    "光线经过黑洞附近时会发生明显偏折",
    "我们会先出低清草稿，再自动细化到目标画质",
    "拖动质量滑块可随时改变时空弯曲强度",
    "高清档位适合截图，流畅档位适合连续调参",
];

const LOADING_STEPS = [
    { title: "正在唤醒引擎", sub: "加载 WASM 与 WebGPU 上屏通道" },
    { title: "绘制首帧草稿", sub: "低分辨率快速预览，无需等待" },
    { title: "追踪测地线", sub: "CPU 参考积分器正在计算光路" },
    { title: "合成最终画面", sub: "叠加色调映射并细化到目标分辨率" },
];

export default class BlackholeView {
    mass = 1.0;
    spinRatio = 0.5;
    integrator = 0;
    diskModel = 1;
    ucfToneMap = true;
    bloom = false;
    width = 640;
    height = 360;
    qualityTier = "standard";
    activePreset = "schwarzschild";
    showAdvanced = false;

    hudMessage = "等待首帧";
    hudTier = "待机";
    footnote = "WebGPU 上屏 · CPU 测地线 · 渐进细化";
    progressPct = 0;
    loadingStep = 0;
    loadingHint = LOADING_HINTS[0];

    booting = false;
    refining = false;
    hasDisplayedFrame = false;
    coldLoaderFading = false;

    _renderTimer = null;
    _renderBusy = false;
    _pendingRender = false;
    _renderGeneration = 0;

    get massLabel() {
        return this.mass.toFixed(1);
    }

    get spinLabel() {
        const a = this.mass * this.spinRatio;
        return `a=${a.toFixed(2)}`;
    }

    get spin() {
        return this.mass * this.spinRatio;
    }

    get sceneName() {
        if (this.activePreset === "custom") {
            return INTEGRATOR_NAMES[this.integrator] ?? "自定义";
        }
        return PRESETS[this.activePreset]?.name ?? "自定义";
    }

    get resolutionLabel() {
        return `${this.width}×${this.height}`;
    }

    get progressStyle() {
        return `width: ${this.progressPct}%`;
    }

    get isLoading() {
        return this.booting || this.refining;
    }

    get showColdLoader() {
        return this.booting && !this.hasDisplayedFrame && !this.coldLoaderFading;
    }

    get showRefineVeil() {
        return this.refining && this.hasDisplayedFrame;
    }

    get loadingTitle() {
        const step = LOADING_STEPS[this.loadingStep] ?? LOADING_STEPS[0];
        return step.title;
    }

    get loadingSubtitle() {
        const step = LOADING_STEPS[this.loadingStep] ?? LOADING_STEPS[0];
        return step.sub;
    }

    get progressLabel() {
        if (this.showColdLoader) {
            return this.loadingTitle;
        }
        if (this.refining) {
            return "正在细化";
        }
        return "准备中";
    }

    onFirstFrameReady() {
        if (this.hasDisplayedFrame) {
            return;
        }
        this.hasDisplayedFrame = true;
        this.coldLoaderFading = true;
        window.setTimeout(() => {
            this.coldLoaderFading = false;
        }, 480);
    }

    updateLoadingStep(pass, passes, final) {
        if (pass === 0) {
            this.loadingStep = 1;
            this.loadingHint = LOADING_HINTS[0];
        } else if (!final) {
            this.loadingStep = 2;
            this.loadingHint = LOADING_HINTS[1];
        } else {
            this.loadingStep = 3;
            this.loadingHint = LOADING_HINTS[2];
        }
        if (final) {
            this.loadingHint = LOADING_HINTS[3];
        }
    }

    async onMount() {
        await this.runRender();
    }

    toggleAdvanced() {
        this.showAdvanced = !this.showAdvanced;
    }

    markCustom() {
        this.activePreset = "custom";
    }

    applyPreset(id) {
        const preset = PRESETS[id];
        if (!preset) {
            return;
        }
        this.activePreset = id;
        this.integrator = preset.integrator;
        this.diskModel = preset.diskModel;
        this.mass = preset.mass;
        this.spinRatio = preset.spinRatio;
        this.scheduleRender(0);
    }

    setQualityTier(tier) {
        const spec = QUALITY_TIERS[tier];
        if (!spec) {
            return;
        }
        this.qualityTier = tier;
        this.width = spec.width;
        this.height = spec.height;
        this.scheduleRender(RESOLUTION_DEBOUNCE_MS);
    }

    scheduleRender(delayMs = SLIDER_DEBOUNCE_MS) {
        if (this._renderTimer !== null) {
            clearTimeout(this._renderTimer);
        }
        this._renderTimer = setTimeout(() => {
            this._renderTimer = null;
            void this.runRender();
        }, delayMs);
    }

    onIntegratorChange(e) {
        this.integrator = Number(e.target.value);
        this.markCustom();
        this.scheduleRender(0);
    }

    onDiskModelChange(e) {
        this.diskModel = Number(e.target.value);
        this.markCustom();
        this.scheduleRender(0);
    }

    onMassInput(e) {
        this.mass = Number(e.target.value);
        this.markCustom();
        this.scheduleRender(SLIDER_DEBOUNCE_MS);
    }

    onSpinInput(e) {
        this.spinRatio = Number(e.target.value);
        this.markCustom();
        this.scheduleRender(SLIDER_DEBOUNCE_MS);
    }

    onToneMapChange(e) {
        this.ucfToneMap = e.target.checked;
        if (!this.ucfToneMap) {
            this.bloom = false;
        }
        this.markCustom();
        this.scheduleRender(0);
    }

    onBloomChange(e) {
        this.bloom = e.target.checked;
        this.markCustom();
        this.scheduleRender(0);
    }

    async runRender() {
        if (this._renderBusy) {
            this._renderGeneration += 1;
            this._pendingRender = true;
            return;
        }

        const canvas = document.getElementById("ton-view");
        if (!(canvas instanceof HTMLCanvasElement)) {
            this.hudMessage = "画布未就绪";
            return;
        }

        const generation = ++this._renderGeneration;
        canvas.width = this.width;
        canvas.height = this.height;
        this._renderBusy = true;
        this.booting = true;
        this.refining = false;
        this.coldLoaderFading = false;
        this.progressPct = 0;
        this.loadingStep = 0;
        this.loadingHint = LOADING_HINTS[0];
        this.hudTier = "准备中";
        this.hudMessage = this.hasDisplayedFrame ? "更新画面中…" : "首次加载，马上就好";
        const t0 = performance.now();

        try {
            const { statusLine, tier } = await renderTonFrame(
                canvas,
                {
                    mass: this.mass,
                    spin: this.spin,
                    integrator: this.integrator,
                    diskModel: this.diskModel,
                    ucfToneMap: this.ucfToneMap,
                    bloom: this.bloom,
                },
                {
                    shouldContinue: () => generation === this._renderGeneration,
                    onPass: (info) => {
                        if (generation !== this._renderGeneration) {
                            return;
                        }
                        this.progressPct = Math.round(((info.pass + 1) / info.passes) * 100);
                        this.hudTier = info.tier;
                        this.updateLoadingStep(info.pass, info.passes, info.final);
                        this.onFirstFrameReady();
                        if (info.final) {
                            this.hudMessage = "画面已就绪";
                            this.booting = false;
                            this.refining = false;
                        } else {
                            this.hudMessage = `草稿 ${Math.round(info.scale * 100)}% · 继续细化中`;
                            this.booting = false;
                            this.refining = true;
                        }
                    },
                },
            );
            if (generation !== this._renderGeneration) {
                return;
            }
            const dt = ((performance.now() - t0) / 1000).toFixed(2);
            const disk = DISK_NAMES[this.diskModel] ?? "盘";
            this.hudTier = tier;
            this.hudMessage = `完成 · 耗时 ${dt} 秒`;
            this.footnote = `${statusLine} · ${disk}`;
            this.progressPct = 100;
            window.setTimeout(() => {
                if (generation === this._renderGeneration) {
                    this.progressPct = 0;
                }
            }, 1200);
        } catch (err) {
            if (generation === this._renderGeneration) {
                this.hudMessage = err instanceof Error ? err.message : String(err);
                this.hudTier = "错误";
                this.footnote = "渲染失败，请刷新页面重试";
            }
        } finally {
            this._renderBusy = false;
            if (this._pendingRender) {
                this._pendingRender = false;
                void this.runRender();
            } else if (generation === this._renderGeneration) {
                this.booting = false;
                this.refining = false;
            }
        }
    }
}
</script>
