{
    "name": "@doki-land/blackhole-darwin-x64",
    "version": "0.1.0",
    "private": true,
    "description": "TON blackhole native platform bag (darwin-x64)",
    "license": "MIT",
    "os": [
        "darwin"
    ],
    "cpu": [
        "x64"
    ],
    "main": "lib/ton.darwin-x64.node",
    "exports": {
        ".": "./lib/ton.darwin-x64.node",
        "./ton.darwin-x64.node": "./lib/ton.darwin-x64.node"
    },
    "files": [
        "lib/ton.darwin-x64.node",
        "readme.md"
    ],
    "scripts": {
        "build:napi": "cargo build -p ton-napi --manifest-path ../../../Cargo.toml --release --target x86_64-apple-darwin && node ./scripts/copy-from-cargo.mjs",
        "copy:napi": "node ./scripts/copy-from-cargo.mjs"
    },
    "publish": false
}
