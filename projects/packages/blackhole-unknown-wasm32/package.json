{
    "name": "@doki-land/blackhole-unknown-wasm32",
    "version": "0.1.0",
    "description": "TON blackhole simulator Wasm loader and WebGPU present (UCF downstream host)",
    "type": "module",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./ton_wasm_bg.wasm": "./lib/ton_wasm_bg.wasm"
    },
    "files": [
        "dist",
        "lib/ton_wasm_bg.wasm"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:wasm": "cargo build -p ton-wasm --manifest-path ../../../Cargo.toml --target wasm32-unknown-unknown --release && node ./scripts/copy-from-cargo.mjs",
        "copy:wasm": "node ./scripts/copy-from-cargo.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@webgpu/types": "^0.1.60",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=18"
    },
    "publish": false
}
