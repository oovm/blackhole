{
    "name": "@doki-land/blackhole",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "description": "TON 黑洞模拟器：ton-* Rust crates + Web 演示",
    "license": "MIT",
    "scripts": {
        "postinstall": "node ./scripts/ensure-vmz-host-manifest.mjs",
        "check": "cargo check --workspace && cargo test --workspace",
        "test": "cargo test --workspace",
        "render": "cargo run -p ton-view -- blackhole.png --width 800 --height 450",
        "build:wasm": "pnpm --filter @doki-land/blackhole-unknown-wasm32 run build:wasm",
        "build:ts": "pnpm --filter @doki-land/blackhole-unknown-wasm32 run build",
        "dev:homepage": "pnpm --filter @doki-land/blackhole-homepage run dev"
    }
}
