{
    "name": "@ton/workspace",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "description": "TON 黑洞模拟器：ton-* Rust crates + Web 演示",
    "license": "MIT",
    "scripts": {
        "check": "cargo check --workspace && cargo test --workspace",
        "test": "cargo test --workspace",
        "render": "cargo run -p ton-view -- blackhole.png --width 800 --height 450",
        "build:wasm": "pnpm --filter @ton/blackhole run build:wasm",
        "build:ts": "pnpm --filter @ton/blackhole run build",
        "dev:homepage": "pnpm --filter @ton/homepage run dev"
    }
}
